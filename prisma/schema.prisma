// Data model for the store. Money is always stored as integer minor units (cents).
// Prices and stock are never accepted from the client; they are read from here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Authentication (managed by Better Auth)
// ─────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  SUPPORT
  ADMIN
}

model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean? @default(false)
  role             Role     @default(CUSTOMER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  profile          CustomerProfile?
  addresses        Address[]
  orders           Order[]
  carts            Cart[]
  reviews          Review[]
  supportRequests  SupportRequest[]
  deletionRequests AccountDeletionRequest[]
  auditLogs        AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ─────────────────────────────────────────────────────────────
// Customers
// ─────────────────────────────────────────────────────────────

model CustomerProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone              String?
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  city       String
  province   String?
  postalCode String
  country    String   @db.Char(2)
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model AccountDeletionRequest {
  id            String                @id @default(cuid())
  userId        String?
  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  status        DeletionRequestStatus @default(PENDING)
  reason        String?
  adminNotes    String?
  processedById String?
  requestedAt   DateTime              @default(now())
  processedAt   DateTime?

  @@index([status])
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  subtitle         String?
  description      String
  productType      String?
  category         String?
  /// [{ text: string, verified: boolean }] — only verified items are shown to shoppers
  highlights       Json          @default("[]")
  /// [{ label: string, value: string, verified: boolean }]
  specifications   Json          @default("[]")
  /// [{ question: string, answer: string }]
  faqs             Json          @default("[]")
  careInstructions String?
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  collections ProductCollection[]
  reviews     Review[]

  @@index([status])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique
  title       String
  /// { "Color": "Lavender" }
  options     Json     @default("{}")
  priceCents  Int
  currency    String   @default("EUR") @db.Char(3)
  swatchHex   String?
  weightGrams Int?
  position    Int      @default(0)
  active      Boolean  @default(true)
  imageId     String?
  // Supplier mapping (CJdropshipping)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  cjProductId String?
  cjVariantId String?
  cjSku       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory    Inventory?
  reservations InventoryReservation[]
  movements    InventoryMovement[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
  @@index([cjVariantId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  width     Int?
  height    Int?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Collection {
  id             String              @id @default(cuid())
  slug           String              @unique
  title          String
  description    String?
  seoTitle       String?
  seoDescription String?
  position       Int                 @default(0)
  published      Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

// ─────────────────────────────────────────────────────────────
// Inventory (prepaid stock held at the supplier warehouse)
// available = supplierQuantity - reservedQuantity - pendingDeductionQuantity - safetyBuffer
// ─────────────────────────────────────────────────────────────

enum InventorySource {
  MANUAL
  CJ
}

model Inventory {
  id                       String          @id @default(cuid())
  variantId                String          @unique
  variant                  ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  source                   InventorySource @default(MANUAL)
  /// Prepaid units held for us by the supplier (last synced or manually set)
  supplierQuantity         Int             @default(0)
  /// Units held by unpaid checkouts
  reservedQuantity         Int             @default(0)
  /// Units sold & paid but not yet confirmed as deducted at the supplier
  pendingDeductionQuantity Int             @default(0)
  safetyBuffer             Int             @default(0)
  lowStockThreshold        Int             @default(10)
  supplierWarehouse        String?
  lastSyncedAt             DateTime?
  syncStatus               String?
  syncError                String?
  lowStockAlertedAt        DateTime?
  updatedAt                DateTime        @updatedAt
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

model InventoryReservation {
  id        String            @id @default(cuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
}

model InventoryMovement {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  field       String
  delta       Int
  reason      String
  reference   String?
  actorId     String?
  createdAt   DateTime       @default(now())

  @@index([variantId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Cart
// ─────────────────────────────────────────────────────────────

model Cart {
  id           String     @id @default(cuid())
  /// SHA-256 of the random token stored in the visitor's http-only cookie
  tokenHash    String     @unique
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountCode String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        CartItem[]

  @@index([userId])
  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

// ─────────────────────────────────────────────────────────────
// Orders & payments
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  REQUIRES_ATTENTION
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  EXPIRED
}

enum FulfillmentStatus {
  UNFULFILLED
  SUBMITTED
  AWAITING_SUPPLIER_CONFIRMATION
  PROCESSING
  SHIPPED
  DELIVERED
  FAILED
  CANCELLED
}

model Order {
  id                      String            @id @default(cuid())
  number                  String            @unique
  userId                  String?
  user                    User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                   String
  status                  OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus           PaymentStatus     @default(UNPAID)
  fulfillmentStatus       FulfillmentStatus @default(UNFULFILLED)
  currency                String            @default("EUR") @db.Char(3)
  subtotalCents           Int
  discountCents           Int               @default(0)
  shippingCents           Int
  /// VAT included in the total (informational; prices are VAT-inclusive)
  taxIncludedCents        Int               @default(0)
  totalCents              Int
  refundedCents           Int               @default(0)
  discountCodeId          String?
  discountCode            DiscountCode?     @relation(fields: [discountCodeId], references: [id])
  discountCodeText        String?
  /// Cart that produced this order; emptied once payment is confirmed
  cartId                  String?
  shippingCountry         String            @db.Char(2)
  shippingRateId          String?
  shippingRateName        String
  shippingEstimate        String?
  /// Address snapshot captured from the payment provider after payment
  shippingAddress         Json?
  billingAddress          Json?
  customerName            String?
  phone                   String?
  stripeCheckoutSessionId String?           @unique
  stripePaymentIntentId   String?           @unique
  /// SHA-256 of a random token that lets a guest view this order
  accessTokenHash         String?
  termsVersion            String?
  termsAcceptedAt         DateTime?
  marketingOptIn          Boolean           @default(false)
  adminNotes              String?
  placedAt                DateTime          @default(now())
  paidAt                  DateTime?
  cancelledAt             DateTime?
  completedAt             DateTime?
  updatedAt               DateTime          @updatedAt

  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]
  reservations      InventoryReservation[]
  fulfillmentOrders FulfillmentOrder[]
  shipments         Shipment[]
  reviews           Review[]

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([placedAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId      String?
  productTitle   String
  variantTitle   String
  sku            String
  imageUrl       String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int
  cjVariantId    String?

  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String
  amountCents Int
  currency    String        @db.Char(3)
  status      PaymentStatus
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  refunds     Refund[]

  @@unique([provider, providerRef])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id])
  amountCents      Int
  reason           String?
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @unique
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Suppliers & fulfillment
// ─────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  /// Non-secret configuration (warehouse country, logistic name...). Credentials live in env vars.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants          ProductVariant[]
  fulfillmentOrders FulfillmentOrder[]
}

model FulfillmentOrder {
  id                  String            @id @default(cuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier          @relation(fields: [supplierId], references: [id])
  status              FulfillmentStatus @default(UNFULFILLED)
  externalOrderId     String?
  externalOrderNumber String?
  attempts            Int               @default(0)
  lastError           String?
  /// Set while a submission is in flight; prevents concurrent duplicate submissions
  lockedAt            DateTime?
  submittedAt         DateTime?
  confirmedAt         DateTime?
  lastResponse        Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  shipments           Shipment[]

  /// One fulfillment order per order & supplier: duplicate submissions are impossible
  @@unique([orderId, supplierId])
  @@index([status])
}

model Shipment {
  id                 String            @id @default(cuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillmentOrderId String?
  fulfillmentOrder   FulfillmentOrder? @relation(fields: [fulfillmentOrderId], references: [id], onDelete: SetNull)
  carrier            String?
  trackingNumber     String
  trackingUrl        String?
  status             String            @default("in_transit")
  shippedAt          DateTime?
  deliveredAt        DateTime?
  lastCheckedAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  events             TrackingEvent[]

  @@unique([orderId, trackingNumber])
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  description String
  location    String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([shipmentId, occurredAt, description])
}

// ─────────────────────────────────────────────────────────────
// Shipping configuration
// ─────────────────────────────────────────────────────────────

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  /// ISO 3166-1 alpha-2 codes
  countries String[]
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  rates     ShippingRate[]
}

model ShippingRate {
  id                 String       @id @default(cuid())
  zoneId             String
  zone               ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name               String
  priceCents         Int
  /// Free shipping only applies when an administrator explicitly sets a threshold
  freeOverCents      Int?
  minDeliveryDays    Int?
  maxDeliveryDays    Int?
  active             Boolean      @default(true)
  position           Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Marketing
// ─────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENT
  FIXED
}

model DiscountCode {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  type              DiscountType
  /// Percent (1-100) or fixed amount in cents
  value             Int
  minSubtotalCents  Int          @default(0)
  maxRedemptions    Int?
  redemptionCount   Int          @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  orders            Order[]
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  authorName       String
  rating           Int
  title            String?
  body             String
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
}

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscription {
  id               String           @id @default(cuid())
  email            String           @unique
  status           NewsletterStatus @default(PENDING)
  tokenHash        String           @unique
  consentText      String
  source           String?
  consentAt        DateTime         @default(now())
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  updatedAt        DateTime         @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Support, privacy & compliance
// ─────────────────────────────────────────────────────────────

enum SupportType {
  GENERAL
  ORDER
  DAMAGED_OR_INCORRECT
  WITHDRAWAL
  DATA_REQUEST
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportRequest {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  email       String
  orderNumber String?
  type        SupportType   @default(GENERAL)
  subject     String
  message     String
  status      SupportStatus @default(OPEN)
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  /// Random anonymous id from the consent cookie, or the user id
  subjectId     String
  userId        String?
  kind          String
  value         Json
  policyVersion String
  createdAt     DateTime @default(now())

  @@index([subjectId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  status      String    @default("received")
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

model IntegrationLog {
  id        String   @id @default(cuid())
  provider  String
  level     String
  action    String
  message   String
  orderId   String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([provider, createdAt])
  @@index([orderId])
}

model EmailLog {
  id         String   @id @default(cuid())
  to         String
  template   String
  subject    String
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Store configuration & content
// ─────────────────────────────────────────────────────────────

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  version   String   @default("draft-1")
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  key       String   @id
  name      String
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}
