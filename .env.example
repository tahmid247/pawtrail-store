# ─────────────────────────────────────────────────────────────
# Copy to .env (local) or set in your host's environment settings (production).
# NEVER commit real values. Everything here is server-only unless prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
# PostgreSQL connection (Supabase: use the pooled connection string with ?pgbouncer=true&connection_limit=1
# for serverless, plus DIRECT_URL for migrations if you add it to schema.prisma). Must use SSL in production (sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"
# 32+ random bytes: `openssl rand -base64 32`. Signs sessions & encrypts 2FA secrets. Rotating it signs everyone out.
BETTER_AUTH_SECRET=""
# Public origin of the site, no trailing slash. Must be https:// in production.
BETTER_AUTH_URL="https://www.example.com"
NEXT_PUBLIC_SITE_URL="https://www.example.com"
# Protects /api/cron/* (Vercel Cron sends it automatically as a Bearer token). `openssl rand -hex 32`
CRON_SECRET=""

# ── Payments: Stripe ─────────────────────────────────────────
# Without these, production checkout is disabled; development uses the built-in payment simulator.
STRIPE_SECRET_KEY=""          # sk_test_… while testing, sk_live_… at launch
STRIPE_WEBHOOK_SECRET=""      # whsec_… from the webhook endpoint you create in the Stripe dashboard
# PAYMENT_SIMULATOR="false"   # set to disable the dev simulator locally

# ── Email: Resend ────────────────────────────────────────────
RESEND_API_KEY=""             # without it, emails are only logged (dev)
EMAIL_FROM="Wanderpaw <orders@yourdomain.com>"   # domain must be verified in Resend
ADMIN_ALERT_EMAIL=""          # receives low-stock, fulfillment-failure and payment-attention alerts

# ── Fulfillment: CJdropshipping ──────────────────────────────
CJ_MODE="mock"                # "mock" (default, never contacts CJ) or "live"
CJ_API_KEY=""                 # from CJ dashboard → My CJ → Authorization → API (server-only)
# CJ_API_BASE_URL="https://developers.cjdropshipping.com/api2.0/v1"
CJ_WEBHOOK_SECRET=""          # random string; register https://YOUR_DOMAIN/api/webhooks/cj?key=<this> in CJ
# CJ_PAY_TYPE=""              # leave unset until confirmed with CJ (see docs/CJ_INTEGRATION.md)

# ── Optional ─────────────────────────────────────────────────
# Encrypts supplier tokens stored in the DB (defaults to a key derived from BETTER_AUTH_SECRET)
DATA_ENCRYPTION_KEY=""
# Product image uploads in production (Supabase Storage, public bucket)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
IMAGE_REMOTE_HOST=""          # e.g. abcd.supabase.co, so next/image can optimise uploaded images
# ADMIN_REQUIRE_2FA="true"    # never set to false in production
